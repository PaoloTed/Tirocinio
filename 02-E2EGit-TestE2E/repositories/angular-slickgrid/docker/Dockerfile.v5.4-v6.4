# ==============================================================================
# Dockerfile per ghiscoding/angular-slickgrid (Versioni v5.4.x – v6.4.0)
# Massima velocita' di build (zero pulizia cache, offline-first, no lint)
# ==============================================================================

ARG BASE_IMAGE=cypress/browsers:node16.16.0-chrome107-ff107-edge
FROM ${BASE_IMAGE}

WORKDIR /app

# 1. Salva i vecchi yarn.lock (se presenti) e pulisce i vecchi sorgenti
RUN cp -f test/cypress/yarn.lock /tmp/old_cypress_yarn.lock 2>/dev/null || true && \
    cp -f yarn.lock /tmp/old_root_yarn.lock 2>/dev/null || true && \
    rm -rf src dist test/cypress/e2e

# 2. Copia il codice sorgente della versione (filtrato da .dockerignore)
COPY . .

# 3. Installazione rapida (senza yarn cache clean) + build libreria (senza lint)
RUN cd test/cypress && \
    if [ ! -d node_modules ] || ! cmp -s yarn.lock /tmp/old_cypress_yarn.lock; then \
        yarn install --frozen-lockfile --prefer-offline --network-timeout 100000; \
    fi && \
    cd /app && \
    if [ ! -d node_modules ] || ! cmp -s yarn.lock /tmp/old_root_yarn.lock; then \
        yarn install --frozen-lockfile --prefer-offline --network-timeout 100000; \
    fi && \
    npx ng-packagr -p ng-package.json && yarn copy:i18n

EXPOSE 4300

# 4. Avvia il server su porta 4300 ed esegue tutti i test (escludendo i due file 000-*)
CMD ["bash", "-c", "yarn start & echo 'Attesa avvio server Angular su porta 4300...' && until curl -s http://localhost:4300 >/dev/null; do sleep 2; done && echo 'Server pronto! Avvio Cypress (senza 000-*)...' && cd test/cypress && npx cypress run --browser chrome --config screenshotOnRunFailure=false,video=false --spec 'e2e/example*.cy.ts,e2e/home.cy.ts'"]
