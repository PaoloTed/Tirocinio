# ==============================================================================
# Dockerfile per ghiscoding/angular-slickgrid (Versioni da v6.5.0 a v8.14.1)
# Massima velocita' di build (zero pulizia cache, offline-first, no lint)
# ==============================================================================

ARG BASE_IMAGE=cypress/browsers:node-20.14.0-chrome-126.0.6478.114-1-ff-127.0.2-edge-126.0.6478.114-1
FROM ${BASE_IMAGE}

WORKDIR /app

# 1. Salva il vecchio yarn.lock (se presente) e pulisce i vecchi sorgenti
RUN cp -f yarn.lock /tmp/old_root_yarn.lock 2>/dev/null || true && \
    rm -rf src dist packages test/cypress/e2e

# 2. Copia il codice sorgente della versione (filtrato da .dockerignore)
COPY . .

# 3. Installazione rapida (senza yarn cache clean) + build libreria (senza lint)
RUN if [ ! -d node_modules ] || ! cmp -s yarn.lock /tmp/old_root_yarn.lock; then \
        yarn install --frozen-lockfile --prefer-offline --network-timeout 100000; \
    fi && \
    (npx ng-packagr -p ng-package.json -c tsconfig.json || npx ng-packagr -p ng-package.json) && yarn copy:i18n

EXPOSE 4300

# 4. Avvio del server su porta 4300 ed esecuzione dei test Cypress (escludendo 000-*)
CMD ["bash", "-c", "yarn start & echo 'Attesa avvio server Angular su porta 4300...' && until curl -s http://localhost:4300 >/dev/null; do sleep 2; done && echo 'Server pronto! Avvio Cypress...' && npx cypress run --config-file test/cypress.config.ts --browser chrome --config screenshotOnRunFailure=false,video=false --spec 'test/cypress/e2e/example*.cy.ts,test/cypress/e2e/home.cy.ts'"]
