# Dockerfile auto-generato per equal-access (Cluster 7: 3.1.27 - 3.1.28)
# Versioni coperte: 3.1.27, 3.1.28
FROM cypress/browsers:node-[16.0.0-chrome-latest

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

# Dipendenze di compilazione per moduli nativi C/C++
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm run build:all && \
    npm run build && \
    npm run build && \
    npm run build && \
    npm run build && \
    npm run build:report && \
    npm run build

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "node main.js & sleep 5 && (cd /app/cypress-accessibility-checker/boilerplates && npx cypress run ${TEST_ARGS:-})"]
