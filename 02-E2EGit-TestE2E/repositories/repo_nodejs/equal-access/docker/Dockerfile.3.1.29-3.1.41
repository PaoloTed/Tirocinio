# Dockerfile auto-generato per equal-access (Cluster 8: 3.1.29 - 3.1.41)
# Versioni coperte: 3.1.29, 3.1.30, 3.1.31, 3.1.32, 3.1.33, 3.1.34, 3.1.35, 3.1.36, 3.1.37, 3.1.38, 3.1.39, 3.1.40, 3.1.41
FROM mcr.microsoft.com/playwright:v1.21.1-jammy

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    npm install && \
    (cd /app/accessibility-checker && npx playwright install chromium) && \
    npm run build:all && \
    npm run build && \
    npm run build && \
    npm run build && \
    npm run build && \
    npm run build:report && \
    npm run build && \
    npm run build

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "node main.js & sleep 5 && (cd /app/accessibility-checker && mocha -R dot test/mocha/**/*.test.js ${TEST_ARGS:-})"]
