# Dockerfile auto-generato per css (Cluster 1: v2.0.0)
# Versioni coperte: v2.0.0
FROM mcr.microsoft.com/playwright:v1.64.1-jammy

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN npm install && \
    (cd /app/benchmarks && npx playwright install chromium) && \
    bun run --filter @master/css-schema build && bun run --filter @master/css-tooling build && bun run --filter @master/css build && bun run --filter @master/css-preset build && bun run --filter @master/css-runtime build

EXPOSE 3000

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "(cd /app/benchmarks && bun --bun vitest run tests ${TEST_ARGS:-})"]
