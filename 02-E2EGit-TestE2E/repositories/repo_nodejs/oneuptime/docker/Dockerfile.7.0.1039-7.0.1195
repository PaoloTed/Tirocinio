# Dockerfile auto-generato per oneuptime (Cluster 4: 7.0.1039 - 7.0.1195)
# Versioni coperte: 7.0.1039, 7.0.1055, 7.0.1078, 7.0.1093, 7.0.1143, 7.0.1144, 7.0.1167, 7.0.1174, 7.0.1183, 7.0.1184, 7.0.1191, 7.0.1192, 7.0.1195
FROM mcr.microsoft.com/playwright:v1.31.2-jammy

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN (cd /app/Common && npm install) && \
    (cd /app/Model && npm install) && \
    (cd /app/CommonServer && npm install) && \
    (cd /app/Playwright && npx playwright install chromium) && \
    npm run build

EXPOSE 3000

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "(cd /app/Playwright && playwright test ${TEST_ARGS:-})"]
