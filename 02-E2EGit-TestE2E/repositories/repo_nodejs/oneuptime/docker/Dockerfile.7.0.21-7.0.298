# Dockerfile auto-generato per oneuptime (Cluster 2: 7.0.21 - 7.0.298)
# Versioni coperte: 7.0.21, 7.0.35, 7.0.38, 7.0.39, 7.0.47, 7.0.53, 7.0.54, 7.0.55, 7.0.56, 7.0.57, 7.0.67, 7.0.69, 7.0.71, 7.0.72, 7.0.75, 7.0.76, 7.0.79, 7.0.81, 7.0.82, 7.0.85, 7.0.86, 7.0.89, 7.0.90, 7.0.98, 7.0.104, 7.0.106, 7.0.109, 7.0.112, 7.0.114, 7.0.119, 7.0.122, 7.0.123, 7.0.126, 7.0.130, 7.0.131, 7.0.134, 7.0.137, 7.0.139, 7.0.141, 7.0.144, 7.0.149, 7.0.155, 7.0.157, 7.0.160, 7.0.162, 7.0.165, 7.0.167, 7.0.169, 7.0.173, 7.0.179, 7.0.182, 7.0.183, 7.0.193, 7.0.197, 7.0.200, 7.0.201, 7.0.204, 7.0.207, 7.0.213, 7.0.219, 7.0.224, 7.0.228, 7.0.231, 7.0.239, 7.0.290, 7.0.291, 7.0.294, 7.0.296, 7.0.297, 7.0.298
FROM mcr.microsoft.com/playwright:v1.31.2-jammy

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN (cd /app/Common && npm install) && \
    (cd /app/Model && npm install) && \
    (cd /app/CommonServer && npm install && npm run test) && \
    (cd /app/Playwright && npx playwright install chromium) && \
    npm run build

EXPOSE 3000

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "(cd /app/Playwright && playwright test ${TEST_ARGS:-})"]
