# Dockerfile auto-generato per react-admin (Cluster 1: v4.12.0 - v4.13.3)
# Versioni coperte: v4.12.0, v4.12.1, v4.12.2, v4.12.3, v4.12.4, v4.13.0, v4.13.1, v4.13.2, v4.13.3
FROM cypress/browsers:node-16.0.0-chrome-latest

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN yarn install --frozen-lockfile && \
    yarn run build

EXPOSE 8080

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "(cd /app/cypress && npx cypress run ${TEST_ARGS:-})"]
