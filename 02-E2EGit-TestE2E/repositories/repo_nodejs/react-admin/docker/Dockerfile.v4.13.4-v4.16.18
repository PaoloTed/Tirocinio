# Dockerfile auto-generato per react-admin (Cluster 2: v4.13.4 - v4.16.18)
# Versioni coperte: v4.13.4, v4.14.0, v4.14.1, v4.14.2, v4.14.3, v4.14.4, v4.14.5, v4.14.6, v4.15.0, v4.15.1, v4.15.2, v4.15.3, v4.15.4, v4.15.5, v4.16.0, v4.16.1, v4.16.2, v4.16.3, v4.16.4, v4.16.5, v4.16.6, v4.16.7, v4.16.8, v4.16.9, v4.16.10, v4.16.11, v4.16.12, v4.16.13, v4.16.14, v4.16.15, v4.16.16, v4.16.17, v4.16.18
FROM cypress/browsers:node-16.0.0-chrome-latest

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN yarn install --frozen-lockfile && \
    make build && \
    make build-demo && \
    zip demo-build.zip -r examples/demo/dist examples/demo/package.json && \
    make build-crm && \
    unzip -o -u demo-build.zip

EXPOSE 8080

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "(cd /app/./examples/demo/dist && python3 -m http.server 4173) & until node -e \"require('http').get('http://localhost:8080', ()=>process.exit(0)).on('error', ()=>process.exit(1))\" 2>/dev/null; do sleep 2; done && (cd /app/cypress && npx cypress run ${TEST_ARGS:-})"]
