# Dockerfile auto-generato per umbrel (Cluster 2: 1.3.0 - 1.5.0)
# Versioni coperte: 1.3.0, 1.4.0, 1.4.1, 1.4.2, 1.5.0
FROM mcr.microsoft.com/playwright:v1.40.1-jammy

ARG APP_VERSION=v0.0.0
ENV HUSKY=0

WORKDIR /app

COPY . .

# Installazione dipendenze, browser e build del progetto
RUN pnpm install && \
    (cd /app/packages/ui && npx playwright install chromium)

EXPOSE 3000

# Avvio server (se previsto) ed esecuzione di tutti i test E2E
CMD ["bash", "-c", "(cd /app/packages/ui && npx playwright test ${TEST_ARGS:-})"]
